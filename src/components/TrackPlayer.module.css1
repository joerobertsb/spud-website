.playButton {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: linear-gradient(to bottom, #002fff 0%, #b0b0b0 50%, #17ff3e 100%);
  border: 1px solid #00ffb3;
  box-shadow:
    0 3px 6px rgba(0, 5, 0, 0.4),
    inset 0 1px 1px rgba(0, 47, 255, 0.6),
    inset 0 -2px 3px rgba(0, 0, 0, 0.2);
}

.playTriangle {
  width: 0;
  height: 0;
  border-top: 8px solid transparent;
  border-bottom: 8px solid transparent;
  border-left: 14px solid #1a1a1a;
  margin-left: 4px;
}

.pauseBars {
  display: flex;
  gap: 4px;
}

.pauseBars span {
  width: 5px;
  height: 16px;
  background: #1a1a1a;
  display: block;
}

.playButton:active {
  background: linear-gradient(to bottom, #6f01ff 0%, #095588 50%, #00ff22 100%);
  box-shadow:
    0 1px 2px rgba(0, 0, 0, 0.4),
    inset 0 1px 3px rgba(0, 0, 0, 0.3);
}

.equalizer {
  display: flex;
  align-items: flex-end;
  gap: 3px;
  height: 20px;
  pointer-events: none;
}

@keyframes eqBounce {
  0%,
  100% {
    transform: scaleY(0.3);
  }
  50% {
    transform: scaleY(1);
  }
}

.equalizer span {
  width: 4px;
  height: 100%;
  background: #4ade80;
  display: block;
  transform-origin: bottom;
  animation: eqBounce 0.8s ease-in-out infinite;
}

.equalizer span:nth-child(1) {
  animation-delay: 0s;
}

.equalizer span:nth-child(2) {
  animation-delay: 0.2s;
}

.equalizer span:nth-child(3) {
  animation-delay: 0.4s;
}

.equalizer span:nth-child(4) {
  animation-delay: 0.1s;
}

.equalizer.paused span {
  animation-play-state: paused;
  transform: scaleY(0.3);
}

.darkPlayer {
  background: #4e0f46;
  border: 2px solid #790dd1;
  border-radius: 0;
  padding: 12px;
}

.darkPlayer :global(.rhap_button-clear) {
  overflow: visible;
}

.darkPlayer :global(.rhap_play-pause-button) {
  width: 48px;
  height: 48px;
}

.darkPlayer :global(.rhap_main-controls-button) {
  overflow: visible;
}

.darkPlayer :global(.rhap_volume-button) {
  overflow: visible;
}

.darkPlayer :global(.rhap_current-time) {
  color: #e79c9c;
}

.darkPlayer :global(.rhap_time) {
  color: #e79c9c;
}

.darkPlayer :global(.rhap_main) {
  display: flex;
  align-items: center;
  gap: 16px;
}

.darkPlayer :global(.rhap_main-controls) {
  display: flex;
  align-items: center;
  gap: 16px;
  flex: 0 0 auto;
}

.darkPlayer :global(.rhap_progress-section) {
  flex: 1 1 auto;
  min-width: 0;
}

.darkPlayer :global(.rhap_progress-container) {
  flex: 1 1 auto;
}

.darkPlayer :global(.rhap_controls-section) {
  display: flex;
  align-items: center;
  gap: 16px;
  flex: 0 0 auto;
}

.darkPlayer :global(.rhap_volume-controls) {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  min-width: 90px;
}

.durationText {
  color: #999;
  font-size: 14px;
  min-width: 40px;
}